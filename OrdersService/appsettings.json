{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Confluent.Kafka": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "order-events",
    "ClientId": "orders-service",
    "MessageTimeoutMs": 10000,
    "RetryBackoffMs": 250
  }
}