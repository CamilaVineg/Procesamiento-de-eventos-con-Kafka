{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Confluent.Kafka": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "order-events",
    "RetryTopic": "order-events-retry",
    "DlqTopic": "order-events-dlq",
    "GroupId": "notification-service",
    "ClientId": "notification-service",
    "OffsetReset": "Earliest",
    "RetryDelayMs": 2000,
    "MaxAttempts": 3
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "From": "notificaciones@tp11.local",
    "User": "",
    "Password": ""
  },
  "Notifications": {
    "FilePath": "data/notifications.jsonl",
    "FailMode": "none"
  }
}