{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Confluent.Kafka": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "Topic": "order-events",
    "GroupId": "analytics-service",
    "ClientId": "analytics-service",
    "OffsetReset": "Earliest"
  },
  "Analytics": {
    "RecentBufferSize": 50,
    "ReportPath": ""
  }
}